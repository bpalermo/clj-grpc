 (defn- default-port []
   (or (some-> (System/getenv "PORT") Long/parseLong) 8080))
 
+;; EXPERIMENT (CALL_EXECUTOR=percall): one long-lived virtual thread per call
+;; instead of a virtual thread per task. grpc-java hands every listener
+;; callback of a call to the call's executor (already serialized per call);
+;; with a thread-per-task executor that is a thread created and torn down per
+;; message. Here the call's thread parks on a queue between messages and is
+;; released by the call's terminal callback, which runs on that same thread.
+(def ^:private ^ThreadLocal call-queue (ThreadLocal.))
+(def ^:private ^Runnable call-end (fn []))
+
+(defn- per-call-executor ^Executor []
+  (let [q (java.util.concurrent.LinkedBlockingQueue.)
+        ^java.lang.Thread$Builder b (Thread/ofVirtual)
+        worker (fn []
+                 (.set call-queue q)
+                 (loop []
+                   (let [^Runnable r (.take q)]
+                     (when-not (identical? r call-end)
+                       (try (.run r) (catch Throwable _))
+                       (recur)))))]
+    (.start (.unstarted b ^Runnable worker))
+    (reify Executor
+      (execute [_ r] (.put q r)))))
+
+(def ^:private per-call-executor-supplier
+  (reify io.grpc.ServerCallExecutorSupplier
+    (getExecutor [_ _call _headers] (per-call-executor))))
+
+(defn- end-call! []
+  (when-let [^java.util.concurrent.LinkedBlockingQueue q (.get call-queue)]
+    (.put q call-end)))
+
+(def ^:private per-call-end-interceptor
+  (reify ServerInterceptor
+    (interceptCall [_ call headers next]
+      (let [l (.startCall ^io.grpc.ServerCallHandler next call headers)]
+        (proxy [io.grpc.ForwardingServerCallListener$SimpleForwardingServerCallListener] [l]
+          (onComplete [] (try (proxy-super onComplete) (finally (end-call!))))
+          (onCancel [] (try (proxy-super onCancel) (finally (end-call!)))))))))
+
 (defn server
   "Build (without starting) a server. Returns {:server io.grpc.Server
   :health HealthStatusManager-or-nil :address SocketAddress}."
