                                        ;; arm: per-message cost with the
                                        ;; per-call machinery amortized away.
                                        :chat
-                                       (fn [send! close!]
-                                         {:on-next (fn [req]
-                                                     (let [{:keys [name payload]} (g/proto->HelloRequest req)]
-                                                       (send! (g/HelloReply->proto
