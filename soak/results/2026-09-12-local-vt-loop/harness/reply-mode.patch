+                                       ;; REPLY (experiment): full = echo the payload (the soak's
+                                       ;; arm); tiny = decode but answer with a 1-field reply;
+                                       ;; none = decode and answer nothing — isolates the write
+                                       ;; path's share of the event loop.
+                                       (let [mode (or (System/getenv "REPLY") "full")]
+                                         (fn [send! close!]
+                                           {:on-next (fn [req]
+                                                       (let [{:keys [name payload]} (g/proto->HelloRequest req)]
