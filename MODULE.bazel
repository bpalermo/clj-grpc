# clj-grpc — gRPC on non-shaded Netty for Clojure, over clj-protobuf.
#
# Bazel is the build and test harness; consumers arrive via Clojars
# (com.github.bpalermo/clj-grpc). build.clj owns the jar/pom/deploy step and
# reads the same deps.edn.
module(
    name = "clj_grpc",
    version = "0.1.0",
)

# The ruleset, from the Bazel Central Registry.
bazel_dep(name = "rules_clj", version = "0.1.0")

native_toolchains = use_extension(
    "@rules_clj//clojure:extensions.bzl",
    "native_toolchains",
    dev_dependency = True,
)
native_toolchains.graalvm(version = "21.0.2")
use_repo(native_toolchains, "graalvm")

register_toolchains(
    "@graalvm//:toolchain",
    dev_dependency = True,
)

deps = use_extension("@rules_clj//clojure:extensions.bzl", "deps")
deps.install(
    name = "deps",
    lock = "//:deps.lock.json",
)
use_repo(deps, "deps")

# For the e2e fixtures: proto_library + java_proto_library give the service
# tests protoc's reference classes, exactly as clj-protobuf's byte-identity
# suite uses them.
bazel_dep(name = "protobuf", version = "35.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Solely for the sh_test wrapping the version-consistency check.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# Soak container images (//bazel/images), rules_img rather than Dockerfiles —
# hermetic, no Docker daemon, consumes the binaries straight from the build
# graph. Dev-only: consumers get a Clojars jar, never an image. Same setup as
# protoc-gen-clojure's bazel/dev image.
bazel_dep(name = "rules_img", version = "0.3.19", dev_dependency = True)

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

# Bases pinned by index digest because tags are mutable; the tag only records
# where the digest came from. Both are multi-platform indexes — the build's
# target platform picks the variant, which is what makes the arm64 CI runner
# produce arm64 images.
pull(
    name = "distroless_base",
    dev_dependency = True,
    digest = "sha256:fabbf1c0c357a3d42550111351daed089b20a2c954df13ee2fcff60602515e84",
    registry = "gcr.io",
    repository = "distroless/base-debian12",
    tag = "latest",
)

pull(
    name = "distroless_java21",
    dev_dependency = True,
    digest = "sha256:f34fd3e4e2d7a246d764d0614f5e6ffb3a735930723fac4cfc25a72798950262",
    registry = "gcr.io",
    repository = "distroless/java21-debian12",
    tag = "latest",
)

# @platforms for the linux-only constraints on the image targets.
bazel_dep(name = "platforms", version = "1.1.0")

# The soak Helm chart (//charts). rules_helm has a native rules_img
# integration: image digests land in values.yaml straight from the build
# graph, which is what retired the pin-digests script. Dev-only for the same
# reason as rules_img — consumers get a Clojars jar, never a chart — and
# because its Go toolchain (rules_go + gazelle) must not enter consumers'
# graphs.
bazel_dep(name = "rules_helm", version = "0.31.0", dev_dependency = True)
