    stamp = "force",
    tag_list = [
        "{{.STABLE_GIT_COMMIT}}",
        "latest",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

# --------------------------------------------------------------------------
# REST: the Pedestal comparison arm, same echo semantics, same base and heap
# as the gRPC JVM arm so the only variable is the stack.

image_layer(
    name = "rest_layer",
    srcs = {"/app.jar": "//bench:soak_rest_server_deploy.jar"},
    target_compatible_with = ["@platforms//os:linux"],
)

image_manifest(
    name = "rest_image",
    base = "@distroless_java21",
    cmd = [],
    entrypoint = [
        "/usr/bin/java",
        "-Xmx512m",
        "-jar",
        "/app.jar",
    ],
    layers = [
        ":pyroscope_agent_layer",
        ":rest_layer",
    ],
    target_compatible_with = ["@platforms//os:linux"],
