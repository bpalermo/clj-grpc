load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:push.bzl", "image_push")

# The three soak arms as container images, consumed by soak/ on a cluster.
#
# rules_img rather than Dockerfiles: hermetic, no Docker daemon, and the
# binaries come straight from the build graph — the native binary is the same
# //bench:coldstart_native artifact every benchmark measured. Built on the
# arm64 CI runner these are arm64 images (the pulled bases are multi-platform
# indexes; the build platform picks the variant), which is what talos-main
# runs. GraalVM cannot cross-compile, so the native image's architecture IS
# the runner's.
#
# Pushes are tagged {{.STABLE_GIT_COMMIT}} + latest (stamped via
# bazel/tools/workspace_status.sh), manual so nothing pushes by accident;
# .github/workflows/build.yaml runs them on main only, gated on the image
# inputs having changed.

package(default_visibility = ["//charts:__pkg__"])

# --------------------------------------------------------------------------
# gRPC native: the greeter server as a GraalVM binary on a glibc base.
# Runtime args are the measured Serial-GC sizing, scaled to the 1 Gi pod.

image_layer(
    name = "grpc_native_layer",
    srcs = {"/coldstart-server": "//bench:coldstart_native"},
    file_metadata = {
        "/coldstart-server": file_metadata(mode = "0755"),
    },
    target_compatible_with = ["@platforms//os:linux"],
)

image_manifest(
    name = "grpc_native_image",
    base = "@distroless_base",
    cmd = [
        "-Xmx512m",
        "-Xmn256m",
        # Explicit, not default: Netty's leak detector samples buffer
        # lifecycles, and the campaign measured it at ~4% of CPU per request
        # at 1,000 rps unary, ~1% at the knee, nothing on streams. A load
        # harness wants the number it is measuring, not a sampling profiler
        # it forgot about; a production deployment should think again.
        # A native image parses -D at run time like a JVM does.
        "-Dio.netty.leakDetection.level=disabled",
    ],
    entrypoint = ["/coldstart-server"],
    layers = [":grpc_native_layer"],
    target_compatible_with = ["@platforms//os:linux"],
)

image_push(
    name = "grpc_native_push",
    image = ":grpc_native_image",
    registry = "ghcr.io",
    repository = "bpalermo/clj-grpc/soak-grpc-native",
    stamp = "force",
    tag_list = [
        "{{.STABLE_GIT_COMMIT}}",
        "latest",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

# --------------------------------------------------------------------------
# gRPC JVM: the identical server as its deploy jar on the distroless JRE.
# Heap capped well under the 1 Gi pod limit; G1 is the JVM default.

# Pyroscope's Java agent, shared by both JVM images: the jar is in the image,
# the entrypoint never loads it. Loading is the chart's decision, per run,
# through JAVA_TOOL_OPTIONS=-javaagent:/pyroscope.jar on the profiled arms —
# because attaching a JVMTI agent is itself the cost: even with its profiler
# off (PYROSCOPE_AGENT_ENABLED=false) an attached agent turns on the JVM's
# virtual-thread transition hooks on every mount and unmount, which taxed the
# VT executor alone and confounded a VT-vs-direct baseline. A profiled and an
# unprofiled run still differ by environment only, and nothing in the image.
# The native image cannot take a -javaagent and does not get this layer.
image_layer(
    name = "pyroscope_agent_layer",
    srcs = {"/pyroscope.jar": "@pyroscope_agent//file"},
    target_compatible_with = ["@platforms//os:linux"],
)

image_layer(
    name = "grpc_jvm_layer",
    srcs = {"/app.jar": "//bench:coldstart_server_deploy.jar"},
    target_compatible_with = ["@platforms//os:linux"],
)

image_manifest(
    name = "grpc_jvm_image",
    base = "@distroless_java21",
    cmd = [],
    entrypoint = [
        "/usr/bin/java",
        "-Xmx512m",
        # See the native arm's cmd: explicit rather than inherited, and off
        # because the harness measures the server, not the leak detector.
        # The REST image gets no such flag — Jetty is not Netty.
        "-Dio.netty.leakDetection.level=disabled",
        "-jar",
        "/app.jar",
    ],
    layers = [
        ":pyroscope_agent_layer",
        ":grpc_jvm_layer",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

image_push(
    name = "grpc_jvm_push",
    image = ":grpc_jvm_image",
    registry = "ghcr.io",
    repository = "bpalermo/clj-grpc/soak-grpc-jvm",
    stamp = "force",
    tag_list = [
        "{{.STABLE_GIT_COMMIT}}",
        "latest",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

# --------------------------------------------------------------------------
# gRPC JVM, typed-interop arm: the identical server built against the
# `interop=true` generated fixture. Same base, same heap, same agent layer and
# the same leak-detection setting as grpc_jvm_image, so the only difference
# between the two arms on a cluster is which generated code encodes.

image_layer(
    name = "grpc_jvm_interop_layer",
    srcs = {"/app.jar": "//bench:coldstart_server_interop_deploy.jar"},
    target_compatible_with = ["@platforms//os:linux"],
