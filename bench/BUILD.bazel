load("@rules_clj//clojure:defs.bzl", "clj_binary", "clj_library", "clj_native_binary", "clj_test")

package(default_visibility = ["//visibility:public"])

clj_library(
    name = "bench_lib",
    srcs = ["clj_grpc/bench.clj"],
    namespaces = ["clj-grpc.bench"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_grpc",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:criterium_criterium",
        "@deps//:io_pedestal_pedestal_jetty",
        "@deps//:io_pedestal_pedestal_service",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
    ],
)

# manual: criterium takes minutes. The smoke test keeps both arms serving and
# agreeing on every bazel test //... instead.
clj_binary(
    name = "run",
    main = "clj-grpc.bench",
    tags = ["manual"],
    deps = [":bench_lib"],
)

clj_library(
    name = "smoke_test_lib",
    srcs = ["clj_grpc/bench_smoke_test.clj"],
    namespaces = ["clj-grpc.bench-smoke-test"],
    strip_prefix = "bench",
    deps = [
        ":bench_lib",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "smoke_test",
    ns = "clj-grpc.bench-smoke-test",
    deps = [":smoke_test_lib"],
)

# ---------------------------------------------------------------------------
# Cold start: time-to-first-RPC, the number Knative scale-from-zero pays.

clj_library(
    name = "coldstart_lib",
    srcs = glob(["clj_grpc/coldstart/*.clj"]),
    namespaces = [
        "clj-grpc.coldstart.server",
        "clj-grpc.coldstart.measure",
        "clj-grpc.coldstart.steady",
    ],
    strip_prefix = "bench",
    deps = [
        "//src:clj_grpc",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The subject: its _deploy.jar is what the arms launch.
clj_binary(
    name = "coldstart_server",
    main_class = "clj_grpc.coldstart.server",
    tags = ["manual"],
    deps = [":coldstart_lib"],
)

# The harness; run with arm segments, see measure.clj docstring.
clj_binary(
    name = "coldstart",
    main = "clj-grpc.coldstart.measure",
    tags = ["manual"],
    deps = [":coldstart_lib"],
)

# ---------------------------------------------------------------------------
# Soak: the REST comparison arm as a standalone, container-shaped server.
# The gRPC soak arms are the coldstart server above; this is the Pedestal
# equivalent with the same echo semantics, $PORT, and a /healthz probe.

clj_library(
    name = "soak_lib",
    srcs = ["clj_grpc/soak/rest_server.clj"],
    namespaces = ["clj-grpc.soak.rest-server"],
    strip_prefix = "bench",
    deps = [
        "@deps//:io_pedestal_pedestal_jetty",
        "@deps//:io_pedestal_pedestal_service",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
    ],
)

clj_binary(
    name = "soak_rest_server",
    main_class = "clj_grpc.soak.rest_server",
    tags = ["manual"],
    deps = [":soak_lib"],
)

# Steady state, same arms: what the ten-thousandth RPC costs once the JVM has
# its JIT and the native image is running what the builder froze.
clj_binary(
    name = "steady",
    main = "clj-grpc.coldstart.steady",
    tags = ["manual"],
    deps = [":coldstart_lib"],
)

# The native arm of the cold-start campaign; also the subject of the steady
# harness's native arm.
clj_native_binary(
    name = "coldstart_native",
    binary_name = "coldstart-server",
    extra_args = [
        "-H:+ReportExceptionStackTraces",
    ],
    jar = ":coldstart_server_deploy.jar",
    tags = ["manual"],
)
