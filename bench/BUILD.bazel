load("@rules_clj//clojure:defs.bzl", "clj_binary", "clj_library", "clj_native_binary", "clj_test")

package(default_visibility = ["//visibility:public"])

clj_library(
    name = "bench_lib",
    srcs = ["clj_grpc/bench.clj"],
    namespaces = ["clj-grpc.bench"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_grpc",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:criterium_criterium",
        "@deps//:io_pedestal_pedestal_jetty",
        "@deps//:io_pedestal_pedestal_service",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
        # Pedestal loads core.async. It is listed here rather than arriving
        # through pedestal's pom because the :async-example alias pins it
        # top-level, and the lockfile records no edges for a top-level pin —
        # the same mechanism that makes src/BUILD.bazel name every netty jar.
        "@deps//:org_clojure_core_async",
    ],
)

# manual: criterium takes minutes. The smoke test keeps both arms serving and
# agreeing on every bazel test //... instead.
clj_binary(
    name = "run",
    main = "clj-grpc.bench",
    tags = ["manual"],
    deps = [":bench_lib"],
)

clj_library(
    name = "smoke_test_lib",
    srcs = ["clj_grpc/bench_smoke_test.clj"],
    namespaces = ["clj-grpc.bench-smoke-test"],
    strip_prefix = "bench",
    deps = [
        ":bench_lib",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "smoke_test",
    ns = "clj-grpc.bench-smoke-test",
    deps = [":smoke_test_lib"],
)

# ---------------------------------------------------------------------------
# Cold start: time-to-first-RPC, the number Knative scale-from-zero pays.

clj_library(
    name = "coldstart_lib",
    srcs = glob(["clj_grpc/coldstart/*.clj"]),
    namespaces = [
        "clj-grpc.coldstart.server",
        "clj-grpc.coldstart.measure",
        "clj-grpc.coldstart.steady",
    ],
    strip_prefix = "bench",
    deps = [
        ":soak_metrics_lib",
        "//src:clj_grpc",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# The subject: its _deploy.jar is what the arms launch. stream_driver_lib
# rides along so the same jar (and thus the soak-grpc-jvm image) can run the
# streaming capacity driver via `clojure.main -m clj-grpc.soak.stream-driver`.
clj_binary(
    name = "coldstart_server",
    main_class = "clj_grpc.coldstart.server",
    tags = ["manual"],
    deps = [
        ":coldstart_lib",
        ":stream_driver_lib",
    ],
)

# The harness; run with arm segments, see measure.clj docstring.
clj_binary(
    name = "coldstart",
    main = "clj-grpc.coldstart.measure",
    tags = ["manual"],
    deps = [":coldstart_lib"],
)

# ---------------------------------------------------------------------------
# Soak: the REST comparison arm as a standalone, container-shaped server.
# The gRPC soak arms are the coldstart server above; this is the Pedestal
# equivalent with the same echo semantics, $PORT, and a /healthz probe.

# Heap/uptime /metrics endpoint, JDK built-ins only — shared by the REST arm
# and the coldstart (gRPC) servers so every soak arm reports heap, native
# image included.
clj_library(
    name = "soak_metrics_lib",
    srcs = ["clj_grpc/soak/metrics.clj"],
    namespaces = ["clj-grpc.soak.metrics"],
    strip_prefix = "bench",
    deps = ["@deps//:org_clojure_clojure"],
)

clj_library(
    name = "soak_lib",
    srcs = ["clj_grpc/soak/rest_server.clj"],
    namespaces = ["clj-grpc.soak.rest-server"],
    strip_prefix = "bench",
    deps = [
        ":soak_metrics_lib",
        "@deps//:io_pedestal_pedestal_jetty",
        "@deps//:io_pedestal_pedestal_service",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
        # Pedestal loads core.async. It is listed here rather than arriving
        # through pedestal's pom because the :async-example alias pins it
        # top-level, and the lockfile records no edges for a top-level pin —
        # the same mechanism that makes src/BUILD.bazel name every netty jar.
        "@deps//:org_clojure_core_async",
    ],
)

clj_binary(
    name = "soak_rest_server",
    main_class = "clj_grpc.soak.rest_server",
    tags = ["manual"],
    deps = [":soak_lib"],
)

# The switch ladder's request bodies. A build action rather than a checked-in
# fixture: the realistic tier is SIZED by encoding it, so the bytes follow the
# proto and the target rather than a copy someone has to remember to refresh.
# //charts:bodies runs this into the chart's files/.
clj_library(
    name = "soak_payload_lib",
    srcs = ["clj_grpc/soak/payload.clj"],
    namespaces = ["clj-grpc.soak.payload"],
    strip_prefix = "bench",
    deps = [
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
    ],
)

clj_binary(
    name = "payload_bodies",
    main_class = "clj_grpc.soak.payload",
    deps = [":soak_payload_lib"],
)

clj_library(
    name = "payload_test_lib",
    testonly = True,
    srcs = ["clj_grpc/soak/payload_test.clj"],
    namespaces = ["clj-grpc.soak.payload-test"],
    strip_prefix = "bench",
    deps = [
        ":soak_payload_lib",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:metosin_jsonista",
        "@deps//:org_clojure_clojure",
    ],
)

clj_test(
    name = "payload_test",
    ns = "clj-grpc.soak.payload-test",
    deps = [":payload_test_lib"],
)

# The bidi-echo capacity driver. Rides inside coldstart_server's deploy jar
# (see that binary's deps) so the published soak-grpc-jvm image can run it
# with a command override — no separate image.
clj_library(
    name = "stream_driver_lib",
    srcs = ["clj_grpc/soak/stream_driver.clj"],
    namespaces = ["clj-grpc.soak.stream-driver"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_grpc",
        "//test:fixtures",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# Steady state, same arms: what the ten-thousandth RPC costs once the JVM has
# its JIT and the native image is running what the builder froze.
clj_binary(
    name = "steady",
    main = "clj-grpc.coldstart.steady",
    tags = ["manual"],
    deps = [":coldstart_lib"],
)

# The native arm of the cold-start campaign; also the subject of the steady
# harness's native arm.
clj_native_binary(
    name = "coldstart_native",
    binary_name = "coldstart-server",
    extra_args = [
        "-H:+ReportExceptionStackTraces",
        # Static everything except glibc: distroless/base has no libz, and the
        # image links zlib dynamically by default — found the hard way as a
        # CrashLoop (exit 127) on the cluster.
        "-H:+StaticExecutableWithDynamicLibC",
        # Keep the symbol table and frame pointers: the cluster's eBPF profiler
        # can unwind this binary either way, but without these every frame is
        # a hex offset. The cost is binary size, not speed.
        "-H:+PreserveFramePointer",
        "-H:-DeleteLocalSymbols",
    ],
    jar = ":coldstart_server_deploy.jar",
    tags = ["manual"],
)

# ---------------------------------------------------------------------------
# The typed-interop soak arm: the same server, the same everything, built
# against //test:fixtures_interop instead of //test:fixtures. One variable —
# which generated arm encodes and decodes — so the ladder can price
# protoc-gen-clojure's `interop=true` against the compiled codec on a real
# service rather than in criterium.
#
# Duplicated targets rather than a select(): the two fixtures provide the same
# namespace, so they must never meet on one classpath, and a target per arm is
# how Bazel states that.

clj_library(
    name = "coldstart_lib_interop",
    srcs = glob(["clj_grpc/coldstart/*.clj"]),
    namespaces = [
        "clj-grpc.coldstart.server",
        "clj-grpc.coldstart.measure",
        "clj-grpc.coldstart.steady",
    ],
    strip_prefix = "bench",
    deps = [
        ":soak_metrics_lib",
        "//src:clj_grpc",
        "//test:fixtures_interop",
        "//test/proto:greeter_java_proto",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_library(
    name = "stream_driver_lib_interop",
    srcs = ["clj_grpc/soak/stream_driver.clj"],
    namespaces = ["clj-grpc.soak.stream-driver"],
    strip_prefix = "bench",
    deps = [
        "//src:clj_grpc",
        "//test:fixtures_interop",
        "//test/proto:greeter_java_proto",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_binary(
    name = "coldstart_server_interop",
    main_class = "clj_grpc.coldstart.server",
    tags = ["manual"],
    deps = [
        ":coldstart_lib_interop",
        ":stream_driver_lib_interop",
    ],
)
