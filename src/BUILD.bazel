load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_maven_export")

package(default_visibility = ["//visibility:public"])

clj_library(
    name = "clj_grpc",
    srcs = glob(["clj_grpc/**/*.clj"]),
    namespaces = [
        "clj-grpc.service",
        "clj-grpc.transport",
        "clj-grpc.impl.netty",
        "clj-grpc.server",
        "clj-grpc.health",
        "clj-grpc.client",
        "clj-grpc.knative",
        "clj-grpc.runtime.service",
    ],
    # The native-image contract rides in the jar: initialize-at-run-time for
    # the Netty leaf (clj_grpc.impl) and the reflection entries its runtime
    # loading needs. native-image discovers META-INF/native-image configs from
    # any jar on the image classpath.
    resources = glob(["META-INF/**"]),
    strip_prefix = "src",
    deps = [
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:io_grpc_grpc_api",
        "@deps//:io_grpc_grpc_core",
        "@deps//:io_grpc_grpc_netty",
        "@deps//:io_grpc_grpc_protobuf",
        "@deps//:io_grpc_grpc_services",
        "@deps//:io_grpc_grpc_stub",
        # Every pinned netty artifact, listed explicitly: the lock records no
        # dependency edges for top-level-pinned libs (their :dependents lists
        # are empty at the root), so transitivity cannot be relied on here.
        "@deps//:io_netty_netty_buffer",
        "@deps//:io_netty_netty_codec",
        "@deps//:io_netty_netty_codec_base",
        "@deps//:io_netty_netty_codec_http",
        "@deps//:io_netty_netty_codec_http2",
        "@deps//:io_netty_netty_codec_socks",
        "@deps//:io_netty_netty_common",
        "@deps//:io_netty_netty_handler",
        "@deps//:io_netty_netty_handler_proxy",
        "@deps//:io_netty_netty_resolver",
        "@deps//:io_netty_netty_transport",
        "@deps//:io_netty_netty_transport_classes_epoll",
        "@deps//:io_netty_netty_transport_native_epoll_linux_aarch_64",
        "@deps//:io_netty_netty_transport_native_epoll_linux_x86_64",
        "@deps//:io_netty_netty_transport_native_unix_common",
        "@deps//:org_clojure_clojure",
    ],
)

# The Clojars artifact: the same sources the library ships, the native-image
# contract that rides with them, and a pom derived from the deps.edn and
# version.edn everything else here reads. What used to be build.clj, a :build
# alias and tools.build.
#
#   bazel build //src:clojars                    the jar and the pom
#   bazel run //src:clojars.publish -- --dry-run every PUT, nothing sent
#   bazel run //src:clojars.publish              the upload
#
# `resources` carries META-INF/native-image, and it is not optional: native-image
# discovers its configuration from any jar on the image classpath, so a published
# jar without it builds an image whose every reflective call dies at run time —
# silently, because that is how native-image fails.
#
# Here rather than in the root package because a glob cannot cross into a
# subpackage, and these sources live in this one.
clj_maven_export(
    name = "clojars",
    srcs = glob(["clj_grpc/**/*.clj"]),
    artifact_id = "clj-grpc",
    deps_edn = "//:deps.edn",
    description = "gRPC for Clojure on non-shaded Netty, over clj-protobuf: dynamic services from generated code, Unix domain sockets, epoll, and Knative presets.",
    group_id = "com.github.bpalermo",
    license = (
        "Apache-2.0",
        "https://www.apache.org/licenses/LICENSE-2.0",
    ),
    resources = glob(["META-INF/**"]),
    scm_url = "https://github.com/bpalermo/clj-grpc",
    strip_prefix = "src",
    url = "https://github.com/bpalermo/clj-grpc",
    version_file = "//:version.edn",
)
