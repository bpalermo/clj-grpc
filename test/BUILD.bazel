load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_test")

package(default_visibility = ["//visibility:public"])

# The generated greeter fixture: real protoc-gen-clojure 0.5.0 output (the
# clj-protobuf.* / clj-grpc.service namespace defaults).
clj_library(
    name = "fixtures",
    srcs = glob(["fixtures/**/*.clj"]),
    namespaces = ["acme.greeter.greeter"],
    strip_prefix = "test/fixtures",
    deps = [
        "//src:clj_grpc",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

TEST_DEPS = [
    ":fixtures",
    "//src:clj_grpc",
    # Flips the fixture's class hints on; the service tests assert the
    # resulting pool alignment, the e2e tests exercise it over the wire.
    "//test/proto:greeter_java_proto",
    "@deps//:com_github_bpalermo_clj_protobuf",
    "@deps//:com_google_protobuf_protobuf_java",
    "@deps//:io_grpc_grpc_api",
    "@deps//:io_grpc_grpc_netty",
    "@deps//:io_grpc_grpc_protobuf",
    "@deps//:io_grpc_grpc_services",
    "@deps//:io_grpc_grpc_stub",
    "@deps//:io_netty_netty_common",
    "@deps//:org_clojure_clojure",
]

clj_library(
    name = "service_test_lib",
    srcs = ["clj_grpc/service_test.clj"],
    namespaces = ["clj-grpc.service-test"],
    strip_prefix = "test",
    deps = TEST_DEPS,
)

clj_test(
    name = "service_test",
    ns = "clj-grpc.service-test",
    deps = [":service_test_lib"],
)

clj_library(
    name = "e2e_test_lib",
    srcs = ["clj_grpc/e2e_test.clj"],
    namespaces = ["clj-grpc.e2e-test"],
    strip_prefix = "test",
    deps = TEST_DEPS,
)

clj_test(
    name = "e2e_test",
    size = "medium",
    ns = "clj-grpc.e2e-test",
    deps = [":e2e_test_lib"],
)

# The non-hinted arm: TEST_DEPS without protoc's Java classes, so the fixture's
# class hints resolve to nothing and every prototype — the namespace's and the
# service's — comes from clj-protobuf's runtime fallback. Two positions of the
# -Dclj-protobuf.codec kill switch, each its own JVM because the runtime reads
# the property once at namespace load: the compiled codec (the default since
# clj-protobuf 0.2.0) and DynamicMessage.
CODEC_TEST_DEPS = [d for d in TEST_DEPS if d != "//test/proto:greeter_java_proto"]

CODEC_POSITIONS = {
    "compiled": [],
    "dynamic": ["-Dclj-protobuf.codec=dynamic"],
}

clj_library(
    name = "service_codec_test_lib",
    srcs = ["clj_grpc/service_codec_test.clj"],
    namespaces = ["clj-grpc.service-codec-test"],
    strip_prefix = "test",
    deps = CODEC_TEST_DEPS,
)

[
    clj_test(
        name = "service_codec_{}_test".format(position),
        jvm_flags = flags,
        ns = "clj-grpc.service-codec-test",
        deps = [":service_codec_test_lib"],
    )
    for position, flags in CODEC_POSITIONS.items()
]

# The whole e2e suite over the wire on each fallback arm — the same namespace
# as :e2e_test, compiled against the classpath without the Java classes.
clj_library(
    name = "e2e_codec_test_lib",
    srcs = ["clj_grpc/e2e_test.clj"],
    namespaces = ["clj-grpc.e2e-test"],
    strip_prefix = "test",
    deps = CODEC_TEST_DEPS,
)

[
    clj_test(
        name = "e2e_{}_test".format(position),
        size = "medium",
        jvm_flags = flags,
        ns = "clj-grpc.e2e-test",
        deps = [":e2e_codec_test_lib"],
    )
    for position, flags in CODEC_POSITIONS.items()
]

clj_library(
    name = "knative_preset_test_lib",
    srcs = ["clj_grpc/knative_preset_test.clj"],
    namespaces = ["clj-grpc.knative-preset-test"],
    strip_prefix = "test",
    deps = TEST_DEPS,
)

clj_test(
    name = "knative_preset_test",
    ns = "clj-grpc.knative-preset-test",
    deps = TEST_DEPS + [":knative_preset_test_lib"],
)

# Pins the native-image contract: requiring the API namespaces must not load
# the Netty leaf (this leg — one namespace per test JVM), and no source file
# outside the leaf may mention a Netty package (the plain-clj leg, which can
# see the source tree).
clj_library(
    name = "lazy_netty_test_lib",
    srcs = ["clj_grpc/lazy_netty_test.clj"],
    namespaces = ["clj-grpc.lazy-netty-test"],
    strip_prefix = "test",
    deps = TEST_DEPS,
)

clj_test(
    name = "lazy_netty_test",
    ns = "clj-grpc.lazy-netty-test",
    deps = [":lazy_netty_test_lib"],
)

clj_library(
    name = "netty_alignment_test_lib",
    srcs = ["clj_grpc/netty_alignment_test.clj"],
    namespaces = ["clj-grpc.netty-alignment-test"],
    strip_prefix = "test",
    deps = TEST_DEPS,
)

clj_test(
    name = "netty_alignment_test",
    ns = "clj-grpc.netty-alignment-test",
    deps = [":netty_alignment_test_lib"],
)
