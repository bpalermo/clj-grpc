load("@rules_clj//clojure:defs.bzl", "clj_binary", "clj_library", "clj_native_binary", "clj_test")

package(default_visibility = ["//visibility:public"])

# The generated namespace: checked-in protoc-gen-clojure 0.4.0 output, produced
# the same way as the test fixture. To regenerate:
#   cd examples/proto && protoc --clojure_out=../gen example/echo/echo.proto
clj_library(
    name = "echo_gen",
    srcs = glob(["gen/**/*.clj"]),
    namespaces = ["example.echo.echo"],
    strip_prefix = "examples/gen",
    deps = [
        "//src:clj_grpc",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_library(
    name = "echo_lib",
    srcs = glob(
        ["src/**/*.clj"],
        exclude = ["src/example/echo/async.clj"],
    ),
    namespaces = [
        "example.echo.server",
        "example.echo.client",
        "example.echo.probe",
    ],
    strip_prefix = "examples/src",
    deps = [
        ":echo_gen",
        # protoc's Java classes: with these on the classpath the generated
        # namespace and the service layer resolve the hinted com.example.echo.*
        # prototypes instead of clj-protobuf's compiled codec. Optional either way.
        "//examples/proto:echo_java_proto",
        "//src:clj_grpc",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

# bazel run //examples:server — h2c on $PORT (default 8080), Knative preset.
clj_binary(
    name = "server",
    main = "example.echo.server",
    tags = ["manual"],
    deps = [":echo_lib"],
)

# bazel run //examples:client [-- host:port] — every streaming shape once.
clj_binary(
    name = "client",
    main = "example.echo.client",
    tags = ["manual"],
    deps = [":echo_lib"],
)

# bazel run //examples:probe [-- host:port] — watch the health service until
# it reports NOT_SERVING. What a rollout sees of a graceful shutdown.
clj_binary(
    name = "probe",
    main = "example.echo.probe",
    tags = ["manual"],
    deps = [":echo_lib"],
)

# ---------------------------------------------------------------------------
# Native image: the same server as a GraalVM binary.
#
# Built from the embedded-descriptor arm — no java_proto classes on the
# classpath — because that arm does all field access through descriptors, with
# no protobuf-java reflection for a native image to be missing registrations
# for. The README's native-image section states the same caveat for consumers.

clj_library(
    name = "echo_embedded_lib",
    srcs = glob(
        ["src/**/*.clj"],
        exclude = [
            "src/example/echo/async.clj",
            "src/example/echo/probe.clj",
        ],
    ),
    namespaces = [
        "example.echo.server",
        "example.echo.client",
    ],
    strip_prefix = "examples/src",
    deps = [
        ":echo_gen",
        "//src:clj_grpc",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
    ],
)

clj_binary(
    name = "server_embedded",
    main_class = "example.echo.server",
    tags = ["manual"],
    deps = [":echo_embedded_lib"],
)

# bazel build //examples:echo_native, then run the binary with $PORT. The ci
# workflow's native job builds this and round-trips the JVM client against it,
# so the native story cannot rot.
clj_native_binary(
    name = "echo_native",
    binary_name = "echo-server",
    jar = ":server_embedded_deploy.jar",
    tags = ["manual"],
)

# The core.async example: a consumer of the public handler shapes, kept out of
# echo_lib and the native image because core.async is its dependency and not
# the library's.
clj_library(
    name = "async_lib",
    srcs = ["src/example/echo/async.clj"],
    namespaces = ["example.echo.async"],
    strip_prefix = "examples/src",
    deps = [
        ":echo_gen",
        "//examples/proto:echo_java_proto",
        "//src:clj_grpc",
        "@deps//:com_github_bpalermo_clj_protobuf",
        "@deps//:com_google_protobuf_protobuf_java",
        "@deps//:org_clojure_clojure",
        "@deps//:org_clojure_core_async",
        # core.async's go machinery loads tools.analyzer.jvm, which needs these
        # two at load time. They are named here because the lockfile attributes
        # each jar to a single parent in the resolved tree — asm's is Jetty's
        # annotations jar and tools.reader's is pedestal — so neither reaches a
        # target through core.async, however the poms read. Same flat-lock
        # limitation that makes src/BUILD.bazel list every netty jar.
        "@deps//:org_clojure_tools_reader",
        "@deps//:org_ow2_asm_asm",
    ],
)

# bazel run //examples:async — the same Echo service, written over channels.
clj_binary(
    name = "async",
    main = "example.echo.async",
    tags = ["manual"],
    deps = [":async_lib"],
)

clj_library(
    name = "async_test_lib",
    srcs = ["test/example/echo/async_test.clj"],
    namespaces = ["example.echo.async-test"],
    strip_prefix = "examples/test",
    deps = [
        ":async_lib",
        ":echo_gen",
        "//src:clj_grpc",
        "@deps//:org_clojure_clojure",
        "@deps//:org_clojure_core_async",
        "@deps//:org_clojure_tools_reader",
        "@deps//:org_ow2_asm_asm",
    ],
)

# Runs on every `bazel test //...`: the round trip, and the backpressure path
# the adapter rests on.
clj_test(
    name = "async_test",
    ns = "example.echo.async-test",
    deps = [":async_test_lib"],
)

clj_library(
    name = "example_e2e_test_lib",
    srcs = glob(
        ["test/**/*.clj"],
        exclude = ["test/example/echo/async_test.clj"],
    ),
    namespaces = ["example.echo.example-e2e-test"],
    strip_prefix = "examples/test",
    deps = [
        ":echo_lib",
        "//src:clj_grpc",
        "@deps//:org_clojure_clojure",
    ],
)

# The example's own round trip on every `bazel test //...`, so the example
# cannot drift from the library.
clj_test(
    name = "example_e2e_test",
    ns = "example.echo.example-e2e-test",
    deps = [":example_e2e_test_lib"],
)
